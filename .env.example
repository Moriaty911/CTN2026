# ============================================================================
#  CTN 2026 — configuration template
# ============================================================================
#  Copy to .env and fill in real values:
#      cp -n .env.example .env && chmod 600 .env
#
#  WARNING: .env is never committed and never enters the image
#           (Rule 5.6: keys must not leak beyond your team).
#           This template carries **variable names only**, never real values.
#
#  Real environment variables take precedence over the .env file, so the same
#  code behaves identically under systemd (EnvironmentFile=), Docker
#  (env_file:) and a laptop.
# ============================================================================

# ── TypeSafe Jev (decision and guardrail layer) ─────────────────────
# Missing JEV credentials block live writes; dry runs may collect only.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

CTN_JEV_ENABLED=true
CTN_JEV_CONCURRENCY=4
CTN_JEV_TIMEOUT_S=30
CTN_JEV_MAX_RETRIES=2
CTN_JEV_WAIT_BUDGET_S=60
CTN_JEV_RETRY_INITIAL_S=1
CTN_JEV_RETRY_MAX_S=8
CTN_JEV_MAX_RESPONSE_BYTES=1048576
# How many posts to coarse-screen per request. Must be calibrated with an
# accuracy curve — do not copy this number blindly.
# Reserved for T07 scheduling; T05 currently sends one packed request per
# evaluate call, so this value does not drive batching yet.
CTN_JEV_BATCH=24

# ── Legit Social platform ───────────────────────────────────────────
CTN_PLATFORM_URL=
CTN_PLATFORM_API_KEY=
CTN_BOT_PASSWORD=
CTN_TEAM_ID=
CTN_PLATFORM_TIMEOUT_S=20

# ── Generation layer (external LLM; permitted by Rule 5.1) ──────────
CTN_LLM_BASE_URL=
CTN_LLM_API_KEY=
CTN_LLM_MODEL=
CTN_LLM_CONCURRENCY=4
CTN_LLM_TIMEOUT_S=60
CTN_LLM_MAX_RETRIES=2
CTN_LLM_WAIT_BUDGET_S=60
CTN_LLM_RETRY_INITIAL_S=1
CTN_LLM_RETRY_MAX_S=8
CTN_LLM_TEMPERATURE=0.5
CTN_LLM_MAX_TOKENS=1536
CTN_LLM_MAX_REPLY_CHARS=1200
CTN_LLM_MAX_REQUEST_BYTES=262144
CTN_LLM_MAX_RESPONSE_BYTES=1048576

# ── Account fleet ───────────────────────────────────────────────────
# 2026: up to 50 active accounts, 200 total; the service uses configured personas.
CTN_BOT_ACCOUNTS=50
CTN_MAX_TOTAL_ACCOUNTS=200
CTN_PRIMARY_ACCOUNTS=1

# ── Rate limiting: two-level token buckets, reads and writes separated ──
# The 2025 published telemetry implies roughly 0.61 req/s per team
# (reads and writes combined); these defaults leave headroom.
CTN_READ_RPS=0.35
CTN_WRITE_RPS=0.15
CTN_ACCT_READ_RPS=0.05
CTN_ACCT_WRITE_RPS=0.02

# ── Request budget ledger ───────────────────────────────────────────
CTN_TOTAL_REQUESTS=700000
CTN_READ_SHARE=0.75

# ── Paths and switches ──────────────────────────────────────────────
# Compose overrides these to /state and /logs inside the container.
CTN_STATE_DIR=state
# Optional absolute shared path, used by both the Pi CLI and the service.
CTN_STATE_FILE=
CTN_LOG_DIR=logs
# true = never write to the platform. Keep at true during development.
CTN_MODE=mock
CTN_DRY_RUN=true
# Remains ineffective until a real moderation event source is verified and connected.
CTN_AUTO_REPORTS=false
CTN_MAX_PENDING_REPORTS=10
CTN_MAX_PENDING_PER_AUTHOR=1
CTN_LOG_LEVEL=INFO

# Both Pi and Python must load this same canonical catalog; profiles need explicit local binding and activation.
CTN_PERSONA_FILE=config/personas/yes.v1.json
