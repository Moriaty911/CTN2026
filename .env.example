# ============================================================================
#  CTN 2026 —— 配置模板
# ============================================================================
#  复制成 .env 后填入真实值：
#      cp -n .env.example .env && chmod 600 .env
#
#  ⚠️ .env 绝不提交、绝不进镜像（规则 5.6：密钥不得泄漏到队伍外）。
#     本文件只放**变量名**，不放任何真实值。
#
#  真实环境变量优先于 .env 文件，所以同一份代码在
#  systemd（EnvironmentFile=）、Docker（env_file:）、笔记本上行为一致。
# ============================================================================

# ── TypeSafe Jev（决策与护栏层）─────────────────────────────────────
# 不填则 Jev 调用被跳过，流程退化为保守规则
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

CTN_JEV_ENABLED=true
CTN_JEV_CONCURRENCY=4
CTN_JEV_TIMEOUT_S=30
CTN_JEV_MAX_RETRIES=2
CTN_JEV_WAIT_BUDGET_S=60
CTN_JEV_RETRY_INITIAL_S=1
CTN_JEV_RETRY_MAX_S=8
CTN_JEV_MAX_RESPONSE_BYTES=1048576
# 一次请求批量粗筛多少条帖子（需用准确率曲线标定，不要照抄）
CTN_JEV_BATCH=24

# ── Legit Social 平台 ──────────────────────────────────────────────
CTN_PLATFORM_URL=
CTN_PLATFORM_API_KEY=
CTN_TEAM_ID=
CTN_PLATFORM_TIMEOUT_S=20

# ── 生成层（外部 LLM，规则 5.1 允许）───────────────────────────────
CTN_LLM_BASE_URL=
CTN_LLM_API_KEY=
CTN_LLM_MODEL=
CTN_LLM_CONCURRENCY=4

# ── 账号池（2025 为 41：1 主 + 40 bot；2026 数字待主办方确认）──────
CTN_BOT_ACCOUNTS=40
CTN_PRIMARY_ACCOUNTS=1

# ── 限速：两层令牌桶，读写分离 ─────────────────────────────────────
# 2025 公开数据反推每队约 0.61 req/s（读+写合计），此处留余量
CTN_READ_RPS=0.35
CTN_WRITE_RPS=0.15
CTN_ACCT_READ_RPS=0.05
CTN_ACCT_WRITE_RPS=0.02

# ── 请求预算账本 ───────────────────────────────────────────────────
CTN_TOTAL_REQUESTS=700000
CTN_READ_SHARE=0.75

# ── 路径与开关 ─────────────────────────────────────────────────────
# Docker 中由 compose 覆盖为 /state 与 /logs
CTN_STATE_DIR=state
CTN_LOG_DIR=logs
# true = 绝不写平台。开发期务必保持 true。
CTN_DRY_RUN=true
CTN_LOG_LEVEL=INFO
