# JEV only. Copy settings into ignored .env or set process environment variables.
# Never put a real key in this template. A live call may incur provider charges.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
CTN_JEV_ENABLED=true
CTN_JEV_CONCURRENCY=4
CTN_JEV_TIMEOUT_S=30
CTN_JEV_MAX_RETRIES=2
CTN_JEV_WAIT_BUDGET_S=60
CTN_JEV_RETRY_INITIAL_S=1
CTN_JEV_RETRY_MAX_S=8
CTN_JEV_MAX_RESPONSE_BYTES=1048576
# Reserved for T07 scheduling; T05 sends one packed request per evaluate call.
CTN_JEV_BATCH=24
