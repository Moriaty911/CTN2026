# Copy to .env.macro. Loaded only by the Pi worker container.
# Pi and Node are installed in the image; no host Pi installation or cron.
# Same model and thinking level as the team's local Pi configuration.
# Explicit CLI arguments take priority over Pi's default settings.
CTN_PI_MODEL=deepseek/deepseek-flash
CTN_PI_THINKING=high

# Fill only the credential needed by the selected Pi provider, or configure
# authentication inside the worker's persistent /home/ctn/.pi directory.
# CTN_LLM_API_KEY configures Python drafting and is not a Pi credential.
# The configured team key is stored in ./state/pi/agent/auth.json, mounted
# into the container. A non-empty DEEPSEEK_API_KEY below overrides that key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
