# ============================================================================
#  CTN 2026 — .gitignore
# ============================================================================
#  两条规则决定了这个文件的内容，请勿随意删减：
#
#  规则 5.6  绝不能把比赛 API key / 凭证泄漏到队伍之外。
#            → 硬编码后 push 即违规，事后再删也没用（git 历史里还在）。
#            → 发现泄漏必须立刻轮换 key 并通知主办方。
#
#  规则 5.2  不得把比赛材料（规则 PDF、选手简报、Discord 截图等）
#            泄漏到队伍之外。
#
#  另外：本仓库在比赛期间必须保持 **private**。
#        公开你的代码 = 把策略白送给对手（尤其你还被允许对他人 agent 做 prompt injection）。
#        赛后如需开源（规则 10.4 允许），请先确认历史里没有以下任何内容。
# ============================================================================


# ---------------------------------------------------------------------------
#  密钥与凭证  ← 最高优先级（规则 5.6）
# ---------------------------------------------------------------------------
.env
.env.*
# 只保留无密钥模板
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

secrets/
credentials/
credentials*.json
service-account*.json
*_token.txt
*_secret*


# ---------------------------------------------------------------------------
#  运行时状态  ← 绝不进 git
# ---------------------------------------------------------------------------
#  理由：状态每秒都在变（巨大且无意义的 diff），体量大，
#        且 `git pull` 到有状态文件的目录会冲突 —— 你的 bot 会停在半路，
#        而比赛正在跑。状态需要的是「备份」，不是「版本控制」。
state/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
checkpoint*
*.ckpt


# ---------------------------------------------------------------------------
#  遥测与日志  ← 绝不进 git
# ---------------------------------------------------------------------------
#  理由：体量大；且含平台内容与遥测数据（规则 4.3 / 6.4 涉及数据处理）。
logs/
*.log
*.jsonl
!strategy/**/*.jsonl   # 例外：手工维护的策略语料可以入库


# ---------------------------------------------------------------------------
#  比赛材料  ← 绝不进 git（规则 5.2）
# ---------------------------------------------------------------------------
#  规则文件、选手信息表、官方客户端模板若来自主办方，先确认可否入库再放。
materials/
briefings/
official/
*.pdf
*.docx
*.pptx
*.xlsx
discord-export*
screenshots/


# ---------------------------------------------------------------------------
#  Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

venv/
.venv/
env/
ENV/
.python-version

build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml


# ---------------------------------------------------------------------------
#  本地缓存 / 临时文件
# ---------------------------------------------------------------------------
.cache/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.swp
*~
scratch/
playground/
*.local.*
local_*

# 本地 JEV 任务与决策清单（用户要求：不提交、不上传）
/JEV_TASKS.local.md
/JEV_INPUT_CONTRACT.local.md


# ---------------------------------------------------------------------------
#  编辑器 / 操作系统
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

.idea/
.vscode/
*.code-workspace
*.sublime-*
.history/


# ---------------------------------------------------------------------------
#  显式保留  ← 这些必须入库
# ---------------------------------------------------------------------------
#  规则 7.5：决赛队伍须向主办方提交全部源码、脚本与工具。
#  因此以下内容**必须**被跟踪，不要加进任何 ignore 规则：
#
#    ctn/**/*.py             源码
#    strategy/**             论点矩阵、人设 voice spec、Jev question set、阈值配置
#                            （语料也是「源码」的一部分，且 git 历史 = 答辩叙事）
#    PREDICTIONS.md          赛前预注册的假设（校准的基准线）
#    requirements.txt        依赖
#    deploy.sh              部署脚本
#    systemd/*.service      进程守护配置
#    docs/**                 说明文档
#    .env.example            配置模板（只有变量名）
