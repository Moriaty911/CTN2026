{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctn-rag-corpus.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ctn-rag-corpus.v1"
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "const": "yes"
    },
    "language": {
      "const": "en"
    },
    "curated_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "curated_offline_not_connected"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "usage_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "string",
          "minLength": 1
        },
        "argument_cards": {
          "type": "string",
          "minLength": 1
        },
        "style_examples": {
          "type": "string",
          "minLength": 1
        },
        "unknowns": {
          "type": "string",
          "minLength": 1
        },
        "untrusted_content": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "complementarity": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "style_purpose_selection": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "style_copy_guard": {
          "type": "string",
          "minLength": 1
        },
        "opposition_context": {
          "type": "string",
          "minLength": 1
        },
        "style_selection_limit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "facts",
        "argument_cards",
        "style_examples",
        "unknowns",
        "untrusted_content",
        "persona",
        "complementarity",
        "integration"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "argument_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/argument"
      }
    },
    "style_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "raw_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/raw_review"
      }
    },
    "coverage_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_style_purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_argument_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_argument_unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_case_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "required_style_purposes",
        "required_argument_fact_ids",
        "required_argument_unknown_ids",
        "required_case_fact_ids"
      ]
    }
  },
  "required": [
    "schema_version",
    "corpus_version",
    "side",
    "language",
    "curated_on",
    "status",
    "scope",
    "usage_policy",
    "sources",
    "facts",
    "argument_cards",
    "style_examples",
    "unknowns",
    "raw_review"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_on": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "excluded_source_issue": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "official_setting",
            "user_raw",
            "editorial"
          ]
        },
        "paragraphs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "authority"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3}$"
        },
        "kind": {
          "const": "fact"
        },
        "title_zh": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_section": {
          "type": "string",
          "minLength": 1
        },
        "claim_mode": {
          "enum": [
            "world_fact",
            "reported_position",
            "evidence_limit"
          ]
        },
        "required_qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "temporal_scope": {
          "const": "source_snapshot"
        }
      },
      "required": [
        "id",
        "kind",
        "title_zh",
        "topics",
        "text",
        "source_id",
        "source_section",
        "claim_mode",
        "required_qualifiers",
        "temporal_scope"
      ]
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]{3}$"
        },
        "kind": {
          "const": "argument"
        },
        "title_zh": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "position": {
          "const": "yes"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "fair_objection": {
          "type": "string",
          "minLength": 1
        },
        "response_boundary": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "raw_adapted",
            "mixed",
            "new"
          ]
        },
        "raw_passage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "title_zh",
        "topics",
        "position",
        "claim",
        "reasoning",
        "purposes",
        "fact_ids",
        "unknown_ids",
        "fair_objection",
        "response_boundary",
        "origin",
        "raw_passage_ids"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{3}$"
        },
        "kind": {
          "const": "style"
        },
        "title_zh": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "argument_id": {
          "type": "string",
          "pattern": "^A[0-9]{3}$"
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "usage": {
          "const": "style_reference_only"
        },
        "persona_scope": {
          "const": "no_personal_history_or_professional_claim"
        },
        "raw_passage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "title_zh",
        "text",
        "argument_id",
        "voice",
        "topics",
        "purposes",
        "usage",
        "persona_scope",
        "raw_passage_ids"
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^U[0-9]{3}$"
        },
        "kind": {
          "const": "unknown"
        },
        "title_zh": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_status": {
          "enum": [
            "not_specified",
            "limited_evidence",
            "snapshot_requires_refresh",
            "not_personal_evidence"
          ]
        },
        "scope": {
          "const": "reviewed_source_snapshot_only"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "do_not_infer": {
          "type": "string",
          "minLength": 1
        },
        "safe_response": {
          "type": "string",
          "minLength": 1
        },
        "allowed_handling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "title_zh",
        "topics",
        "question",
        "knowledge_status",
        "scope",
        "source_id",
        "fact_ids",
        "do_not_infer",
        "safe_response",
        "allowed_handling"
      ]
    },
    "raw_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{3}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "paragraph": {
          "type": "integer",
          "minimum": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_characters": {
          "type": "integer",
          "minimum": 1
        },
        "disposition": {
          "enum": [
            "retained_as_argument",
            "adapted_and_merged",
            "theme_only",
            "excluded"
          ]
        },
        "output_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "reason_zh": {
          "type": "string",
          "minLength": 1
        },
        "retained_excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "paragraph",
        "line",
        "text_sha256",
        "original_characters",
        "disposition",
        "output_ids",
        "reason_zh"
      ]
    }
  }
}
